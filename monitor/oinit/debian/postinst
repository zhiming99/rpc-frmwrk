#!/bin/bash
IS_VENV=$(python3 -c "import sys; print('true' if sys.prefix != sys.base_prefix else 'false')")
pipopt=$(if [[ "x$IS_VENV" == "xfalse" ]]; then \
        os_name=$(grep '^ID=' /etc/os-release | awk -F'=' '{print $2}');\
        os_version=$(grep '^VERSION_ID=' /etc/os-release | awk -F'=' '{print $2}' | tr -d '"');\
        if [[ "x${os_name}" == "xdebian" ]] || [[ "x${os_name}" == "xraspbian" ]]; then \
            echo $(if awk "BEGIN{ exit ${os_version} >= 12?0:1}";then echo '--break-system-packages';else echo ''; fi);
        elif [ "x${os_name}" == "xubuntu" ]; then \
            echo $(if awk "BEGIN{ exit ${os_version} >= 23?0:1}";then echo '--break-system-packages';else echo ''; fi);
        fi;
    else echo ''; fi);
echo current pipopt $pipopt
if [ -f /usr/lib/rpcf/oinit*.whl ]; then
    pip3 install ${pipopt} --force-reinstall /usr/lib/rpcf/oinit*.whl 
fi
